                   {
                       "id":  8,
                       "type":  "bargauge",
                       "title":  "Rejection reasons (last 15m)",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  12,
                                       "w":  12,
                                       "h":  8
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${datasource}"
                                      },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sort_desc(sum by (code) (increase(finsecure_validation_errors_total[15m])))",
                                           "legendFormat":  "{{code}}",
                                           "instant":  true
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "none",
                                                            "decimals":  0,
                                                            "color":  {
                                                                          "mode":  "fixed",
                                                                          "fixedColor":  "#2a78d6"
                                                                      },
                                                            "min":  0
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "orientation":  "horizontal",
                                       "displayMode":  "basic",
                                       "showUnfilled":  true,
                                       "valueMode":  "color",
                                       "namePlacement":  "left",
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
                                                         }
                                   }
                   },
                   {
