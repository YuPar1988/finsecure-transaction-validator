                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "color",
                                                                                        "value":  {
                                                                                                      "mode":  "fixed",
                                                                                                      "fixedColor":  "#2a78d6"
                                                                                                  }
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "p95"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "color",
                                                                                        "value":  {
                                                                                                      "mode":  "fixed",
                                                                                                      "fixedColor":  "#eb6834"
                                                                                                  }
                                                                                    }
                                                                                ]
