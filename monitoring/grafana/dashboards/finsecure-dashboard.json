                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${datasource}"
                                      },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum by (pod) (jvm_memory_used_bytes{area=\"heap\", application=\"transaction-validator\"})",
